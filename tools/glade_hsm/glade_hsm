#!/usr/bin/env bash

#----------------------------------------------------------------------------
# environment
SCRIPTDIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
#[ -f ${SCRIPTDIR}/config_env.sh ] && . ${SCRIPTDIR}/config_env.sh || \
#    { echo "cannot locate ${SCRIPTDIR}/config_env.sh}"; exit 1; }
#----------------------------------------------------------------------------



#----------------------------------------------------------------------------
usage ()
{
    cat <<EOF
Usage: $0 <migrate|recall|status> <subcommand options> <dirnames>
       migrate:
        foo

       recall:
         bar

       status:
         baz
EOF

}




#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
origARGS=$@
mode="none"
DIRLIST=()

parse_args ()
{
    # check the first argument
    case $1 in
        "migrate"|"recall"|"status")
            mode=$1
            shift

            while [ $# -gt 0 ] ; do
                case $1 in

                    *)
                        if [ -d $1 ]; then
                            fullpath="$( cd "${1}" >/dev/null 2>&1 && pwd )"

                            DIRLIST+=( ${fullpath} ) # save directory in an array for later
                        else
                            # unknown option
                            echo "unrecognized argument: $1"
                            echo "  directory name expected!!"
                            usage
                            exit 1
                        fi
                        shift # past argument
                    ;;
                esac
            done

            ;;
        *)
            usage
            exit 1
            ;;
    esac

    echo $@
    return
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
do_migration ()
{
    sortedlist="$(echo "${DIRLIST[@]}" | tr " " "\n" |  grep -v "COLD_STORAGE" | sort -r)"

    #echo "migrating DIRLIST = ""${DIRLIST[@]}" && echo
    echo "sortedlist = "
    echo "${sortedlist}" && echo

    MIGRATEDDIRS=()

    for dir in ${sortedlist}; do
        if [[ ${dir} = */COLD_STORAGE* ]]; then
            echo "--> Skpping ${dir} (path already contains \"*/COLD_STORAGE\"...)"
            continue
        else
            echo "Migrating ${dir}"
        fi

        origdir=${dir}
        basedir=$(basename ${dir})
        oldtopdir=$(dirname ${dir})
        newtopdir=${oldtopdir}/COLD_STORAGE
        newdir=${newtopdir}/${basedir}

        echo "  origdir = " ${origdir}
        echo "  newdir  = " ${newdir}
        echo

        if [ -d ${newdir} ]; then
            echo "  *** WARNING: newdir collision!! ***"
            echo "  --> skipping ${origdir} since ${newdir} exists"
            continue
        fi

        set -x
        mkdir -p ${newtopdir}
        mv ${origdir} ${newdir}

        MIGRATEDDIRS+=( ${newdir} )

        logfile=${newdir}/.glade_hsm_metadata
        echo "# $(date)" > ${logfile}
        echo "# user = $(whoami)" >> ${logfile}
        echo "# origdir = ${origdir}" >> ${logfile}
        echo "# newdir  = ${newdir}"  >> ${logfile}
        set +x

    done

    echo "MIGRATEDDIRS = ""${MIGRATEDDIRS[@]}" && echo
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
do_recall ()
{
    sortedlist="$(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "COLD_STORAGE/" | sort -r)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
do_status ()
{
    echo "Not implemented!!"
    exit 1

    sortedlist="$(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "COLD_STORAGE/" | sort -r)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo
}



#----------------------------------------------------------------------------
# main program follows
#----------------------------------------------------------------------------
parse_args $@
echo $@
echo "mode = "$mode
#echo "DIRLIST = ""${DIRLIST[@]}"


case ${mode} in
    "migrate"|"recall"|"status")
        do_${mode}
        ;;

    *)
        echo "unknown mode ${mode} / not implemented!!"
        exit 1
        ;;
esac
