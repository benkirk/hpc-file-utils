#----------------------------------------------------------------------------
# glade_hsm recall <filename(s)> subcommand
#----------------------------------------------------------------------------
recall_files ()
{
    sortedlist="$(echo "${FILELIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE" | sort -r | uniq)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo

    for file in ${sortedlist}; do

        ${MMLSATTR} -L "${file}" | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 || continue

        echo ${file}

        recall_request_stub="${log_dir}/$(pathname_to_label ${file})"
        recall_request_file="${recall_request_stub}::${timestamp}"
        recall_request_log="${recall_request_file}.log"
        recall_request_flist="${recall_request_file}.filelist"
        echo ${recall_request_file}


        echo "# ${file} : recall requested on ${timestamp} by ${USER}" > "${recall_request_log}"
        echo "# (see ${recall_request_flist} for listing of recalled files)" >> "${recall_request_log}"
        echo "${file}" >> "${recall_request_flist}"
    done
}



#----------------------------------------------------------------------------
# glade_hsm recall <dirname(s)> subcommand
#----------------------------------------------------------------------------
recall_dirs ()
{
    sortedlist="$(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE" | sort -r | uniq)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo

    for dir in ${sortedlist}; do
        cd ${dir} || continue

        curdir=$(pwd)                  # full path to recall directory

        recall_request_stub="${log_dir}/$(pathname_to_label ${curdir})"
        recall_request_file="${recall_request_stub}::${timestamp}"
        recall_request_log="${recall_request_file}.log"
        recall_request_flist="${recall_request_file}.filelist"
        echo ${recall_request_file}

        echo "# ${curdir} : recall requested on ${timestamp} by ${USER}" > "${recall_request_log}"
        echo "# (see ${recall_request_flist} for listing of recalled files)" >> "${recall_request_log}"

        while read -r -d '' file; do
            ${MMLSATTR} -L "${file}" | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 || continue
            echo "${file}" >> "${recall_request_flist}"
        done < <(find ${curdir} ! -type d -print0)
    done
}



#----------------------------------------------------------------------------
# glade_hsm recall subcommand
#----------------------------------------------------------------------------
do_recall ()
{
    recall_files
    recall_dirs
}



#----------------------------------------------------------------------------
# glade_hsm status <filename(s)> subcommand
#----------------------------------------------------------------------------
status_files ()
{
    while read -r file; do
        status="online "

        ${MMLSATTR} -L "${file}" | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 && status="offline"

        echo "${file} : ${status} [$(du -h --apparent-size ${file} | awk '{print $1}')]"

    done < <(echo "${FILELIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE") # | sort -r | uniq)
}



#----------------------------------------------------------------------------
# glade_hsm status <dirname(s)> subcommand
#----------------------------------------------------------------------------
status_dirs ()
{
    while read -r dir; do
        cd ${dir} || continue

        curdir=$(pwd)

        echo ${curdir}
        echo "  Disk Volume:  $(du -hs ${curdir} | awk '{print$1}')"
        echo "  Total Volume: $(du --apparent-size -hs ${curdir} | awk '{print$1}')"

        nfiles=0
        noffline=0

        while read -r -d '' file; do
            ((++nfiles))
            #echo "${file} / ${nfiles} / ${noffline}"
            ${MMLSATTR} -L "${file}" | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 || continue
            noffline=$((++noffline))
        done < <(find ${curdir} -readable ! -type d -print0)

        echo "  Total files: ${nfiles} / offline: ${noffline}"

        while read -r -d '' logfile; do
            #echo ${logfile}
            grep "${curdir}" ${logfile} -c >/dev/null 2>&1 || continue
            echo "Recall status from ${logfile}"
            cat ${logfile}
        done < <(find ${log_dir} -type f -name "*.log" -print0)
        echo
     done < <(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE") # | sort -r | uniq)"
}



#----------------------------------------------------------------------------
# glade_hsm status subcommand
#----------------------------------------------------------------------------
do_status ()
{
    status_files
    status_dirs
}



#----------------------------------------------------------------------------
# main program follows
#----------------------------------------------------------------------------
parse_args $@

case ${mode} in
    "migrate"|"recall"|"status")
        do_${mode}
        ;;

    *)
        echo "unknown mode ${mode} / not implemented!!"
        exit 1
        ;;
esac
