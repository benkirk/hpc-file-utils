usage ()
{
    cat <<EOF
Usage: ${0} <migrate|recall|status> <subcommand options> <dirnames>
       migrate:
        foo

       recall:
         bar

       status:
         baz
EOF
}



#----------------------------------------------------------------------------
# variables & default vaules
#----------------------------------------------------------------------------
origARGS=$@
mode="none"
DIRLIST=()
FILELIST=()

timestamp=$(date +%F@%T)

log_dir="/glade/u/CS_HSM/requests"
[ -w ${log_dir} ] || log_dir=$(pwd)


#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
parse_args ()
{
    # check the first argument
    case ${1} in

        "migrate"|"recall"|"status")
            mode=${1}
            shift

            while [ ${#} -gt 0 ] ; do
                case ${1} in

                    *)
                        if [ -d ${1} ]; then
                            fullpath="$( cd "${1}" >/dev/null 2>&1 && pwd )"
                            DIRLIST+=( ${fullpath} ) # save directory in an array for later

                        elif [ -f ${1} ]; then
                            fullpath="$(readlink -f "${1}")"
                            FILELIST+=( ${fullpath} ) # save file in an array for later

                        else
                            # unknown option
                            echo "unrecognized argument: ${1}"
                            echo "  file or directory name expected!!"
                            usage
                            exit 1
                        fi
                        shift # past argument
                    ;;
                esac
            done

            ;;

        # not recognized?
        *)
            usage
            exit 1
            ;;
    esac

    echo $@
    return
}



#----------------------------------------------------------------------------
# utility to transform full path name to a string for use in file labels.
#----------------------------------------------------------------------------
pathname_to_label ()
{
    [ ${#} -eq 1 ] || { echo "Usage: pathname_to_label <pathname>"; exit 1; }

    curdir=${1}                     # full path to recall directory
    curdirstr=${curdir/\//}         # replace the first '/' only
    curdirstr=${curdirstr//\//\\\\} # replace remaining '/' with \/

    recall_request_stub="${USER}::${curdirstr}"

    echo ${recall_request_stub}
    return 0
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
migrate_files ()
{
    sortedlist="$(echo "${FILELIST[@]}" | tr " " "\n" |  grep -v "COLD_STORAGE" | sort -r | uniq)"

    #echo "migrating FILELIST = ""${FILELIST[@]}" && echo
    echo "sortedlist = "
    echo "${sortedlist}" && echo

    MIGRATEDFILES=()

    for file in ${sortedlist}; do
        if [[ ${file} = */COLD_STORAGE* ]]; then
            echo "--> Skpping ${file} (path already contains \"*/COLD_STORAGE\"...)"
            continue
        else
            echo "Migrating ${file}"
        fi

        origfile=${file}
        basefile=$(basename ${file})
        oldtopdir=$(dirname ${file})
        newtopdir=${oldtopdir}/COLD_STORAGE
        newfile=${newtopdir}/${basefile}

        echo "  origfile = " ${origfile}
        echo "  newfile  = " ${newfile}
        echo

        if [ -e ${newfile} ]; then
            echo "  *** WARNING: newfile collision!! ***"
            echo "    --> skipping ${origfile}"
            echo "    --> since ${newfile} exists"
            continue
        fi

        set -x
        mkdir -p ${newtopdir}
        mv ${origfile} ${newfile}

        MIGRATEDFILES+=( ${newfile} )

        # logfile=${newdir}/.glade_hsm_metadata
        # echo "# $(date)" > ${logfile}
        # echo "# user = $(whoami)" >> ${logfile}
        # echo "# origdir = ${origdir}" >> ${logfile}
        # echo "# newdir  = ${newdir}"  >> ${logfile}
        set +x

    done

    echo "MIGRATEDFILES = ""${MIGRATEDFILES[@]}" && echo
}



