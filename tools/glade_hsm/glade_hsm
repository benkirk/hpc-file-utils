#!/usr/bin/env bash

#----------------------------------------------------------------------------
# environment
SCRIPTDIR="$( cd "$( dirname $(realpath "${BASH_SOURCE[0]}") )" >/dev/null 2>&1 && pwd )"
MMLSATTR="${MMLSATTR:-/usr/lpp/mmfs/bin/mmlsattr}"
#----------------------------------------------------------------------------

# -e: exit on error
# -u: treat unset variables as errors
# -o pipefail: fail if any command in a pipeline fails
set -euo pipefail



#----------------------------------------------------------------------------
# variables & default vaules
#----------------------------------------------------------------------------
export GPFS_BLOCKSIZE=512
export HSM_THRESHOLD_SIZE_CHECK=$(( 50 * 1024 * 1024 ))

origARGS=$@
mode="none"
single_copy=false
cold_storage_pathname="COLD_STORAGE"
CONFIRM=YES
DIRLIST=()
FILELIST=()


#timestamp=$(date +%F@%T)
timestamp()
{
    echo "$(date +%F@%T)"
}

# log_dir - can be overridden for testing
log_dir="${log_dir:-/glade/u/CS_HSM/requests}"

[[ -w ${log_dir} ]] || { echo "No writable logdir found!!"; exit 1; }



#----------------------------------------------------------------------------
# migrate subcommand help message
#----------------------------------------------------------------------------
usage_migrate ()
{
    cat <<EOF
    migrate:
       Relocates files/directories in preparation for HSM migration.

       For each specified <dirname(s)>, <filename(s)>, relocates entity into a
       "/COLD_STORAGE/" path in preparation for HSM migration.

       Example:

          glade_hsm migrate [--single-copy] /glade/campaign/mylab/myproj/results/

            will relocate
              /glade/campaign/mylab/myproj/results/ ->
              /glade/campaign/mylab/myproj/COLD_STORAGE/results/

       Batch system processes then run at regular intervals and migrate all
       large files (>=100MB) underneath "/COLD_STORAGE/" paths onto tape storage.
       All files inside a "/COLD_STORAGE/" are marked immutable regardless of size,
       which prevents modification of contents and metadata (permissions, etc.).

       Name collisions are reported but must be resolved by the user.
EOF
}



#----------------------------------------------------------------------------
# recall subcommand help message
#----------------------------------------------------------------------------
usage_recall ()
{
    cat <<EOF
    recall:
      Submits a recall request for entire directory tree(s), or listed file(s).

       Example:

          glade_hsm recall /glade/campaign/mylab/myproj/COLD_STORAGE/results/

            requests that all previously migrated files inside
              /glade/campaign/mylab/myproj/COLD_STORAGE/results/
            be recalled from tape to disk in order to become readable.
            All files have their "immutability" attribute removed, allowing for modification.

       NOTE: recalled files can be read from inside their "/COLD_STORAGE/" location
       for 7 days, after which they will be re-migrated at the next scheduled interval.
       To permanently extract a file/directory from HSM, manually mv outside of "/COLD_STORAGE/".
EOF
}



#----------------------------------------------------------------------------
# status subcommand help message
#----------------------------------------------------------------------------
usage_status ()
{
    cat <<EOF
    status:
      Summarizes the on-disk and total volume consumed by <dirname(s)>.
      Reports status of any outstanding recall requests for the specified <dirname(s)>, if any.

       Example:

          glade_hsm status /glade/campaign/univ/uiuc0017/SouthAmerica_WRF4KM_PGW/COLD_STORAGE/

            /glade/campaign/univ/uiuc0017/SouthAmerica_WRF4KM_PGW/COLD_STORAGE
            Disk Volume:  61T
            Total Volume: 444T
            Recall status from /glade/u/CS_HSM/requests/benkirk::glade\\campaign\\univ\\uiuc0017\\SouthAmerica_WRF4KM_PGW\\COLD_STORAGE\\2002::2023-08-04@12:54:55.log
            # /glade/campaign/univ/uiuc0017/SouthAmerica_WRF4KM_PGW/COLD_STORAGE/2002 : recall requested on 2023-08-04@12:54:55 by benkirk
EOF
}



#----------------------------------------------------------------------------
# top-level help message
#----------------------------------------------------------------------------
usage ()
{
    cat <<EOF
Usage: ${0} <migrate|recall|status> <subcommand options> <dirname(s)> <filename(s)>
EOF
    usage_migrate && echo && echo
    usage_recall && echo && echo
    usage_status
}


#----------------------------------------------------------------------------
# process command line arguments
#----------------------------------------------------------------------------
parse_args ()
{
    cmd=$(basename ${0})

    [[ ${#} -gt 0 ]] || { usage; exit 0; }

    # check the first argument
    case ${1} in

        "-h"|"--help")
            usage
            exit 0
            ;;

        "migrate"|"recall"|"status")
            mode=${1}
            shift

            while [[ ${#} -gt 0 ]] ; do
                case ${1} in

                    "-h"|"--help")
                        usage_${mode}
                        exit 0
                        ;;

                    "-f"|"--force")
                        CONFIRM="NO"
                        shift # past argument
                        ;;

                    "--single-copy")
                        single_copy=true
                        cold_storage_pathname="COLD_STORAGE_SINGLE_COPY"
                        echo "*** Migrated files will be limited to a single tape copy ***"
                        shift # past argument
                        ;;

                    *)
                        if [[ -d ${1} ]]; then
                            # ensure we can access the directory...
                            fullpath="$( cd "${1}" >/dev/null 2>&1 && pwd )"
                            # then canonicalize
                            fullpath="$(realpath ${fullpath})"
                            case "${fullpath}" in
                                "/glade/campaign/"*|"/gpfs/csfs1/"*)
                                    DIRLIST+=( ${fullpath} ) # save directory in an array for later
                                    ;;
                                *)
                                    echo "Invalid directory: ${fullpath} - ${cmd} only functions on Campaign Storage."
                                    exit 1
                                    ;;
                            esac

                        elif [[ -f ${1} ]]; then
                            fullpath="$(realpath "${1}")"
                            case "${fullpath}" in
                                "/glade/campaign/"*|"/gpfs/csfs1/"*)
                                    FILELIST+=( ${fullpath} ) # save file in an array for later
                                    ;;
                                *)
                                    echo "Invalid file: ${fullpath} - ${cmd} only functions on Campaign Storage."
                                    exit 1
                                    ;;
                            esac

                        else
                            # unknown option
                            echo "unrecognized argument: ${1}"
                            echo "  file or directory name expected!!"
                            usage
                            exit 1
                        fi
                        shift # past argument
                        ;;
                esac
            done

            #  Check if both DIRLIST and FILELIST arrays are empty
            if [[ ${#DIRLIST[@]} -eq 0 ]] && [[ ${#FILELIST[@]} -eq 0 ]]; then
                echo -e "${cmd} ${mode} : No arguments specified\n\n"
                usage
                exit 1
            fi
            ;;

        # not recognized?
        *)
            usage
            exit 0
            ;;
    esac

    #echo $@
    return
}



#----------------------------------------------------------------------------
# Promt user for confirmation and capture response
#----------------------------------------------------------------------------
get_confirmation()
{
    local msg="$@"
    confirmed=0
    if [[ "NO" == "${CONFIRM}" ]]; then
        confirmed=1
        return 0
    else
        printf "%b" "${msg} " # <-- interprets any \n in ${msg}
        read -n 1 -r reply </dev/tty
        echo
        if [[ ${reply} =~ ^[Yy]$ ]]; then
            confirmed=1
            return 0
        fi
    fi

    return 1
}



#----------------------------------------------------------------------------
# utility to transform full path name to a string for use in file labels.
#----------------------------------------------------------------------------
pathname_to_label ()
{
    [[ ${#} -eq 1 ]] || { echo "Usage: pathname_to_label <pathname>"; exit 1; }

    curdir=${1}                         # full path to recall directory
    curdir=$(realpath "${curdir}")      # canonicalize path
    #curdirstr=${curdir/\//}            # replace the first '/' only
    #curdirstr=${curdirstr//\//\\\\}    # replace remaining '/' with \/
    curdirsha=$(echo ${curdir} | sha256sum | awk '{print $1}')
    stub="${curdirsha}"

    echo ${stub}
    return 0
}



#----------------------------------------------------------------------------
# Check file state to determine if online or offline
#----------------------------------------------------------------------------
check_file_status()
{
    [[ ${#} -eq 1 ]] || { echo "Usage: check_file_status <pathname>"; exit 1; }
    [[ -f ${1} ]] || { echo -e " not a file?: ${1}\nUsage: check_file_status <pathname>"; exit 1; }

    local file=$(realpath ${1})

    status="INVALID"

    read nblocks true_size < <(stat --format="%b %s" ${file})
    ondisk_size=$(( ${nblocks} * ${GPFS_BLOCKSIZE} ))
    ratio=$(( ${ondisk_size} / ${true_size} ))

#     cat <<EOF
# file: ${file}
# nblocks: ${nblocks}
# true_size:   ${true_size}
# ondisk_size: ${ondisk_size}
# ratio:       ${ratio}
# EOF

    # we only migrate 'large' files'; (>100MiB).
    # for tiny files less than our blocksize are never migrated, and the ratio is inappropriate
    if [[ ${true_size} -lt ${HSM_THRESHOLD_SIZE_CHECK} ]]; then
        status="on disk"
    else
        [[ 1 -eq ${ratio} ]] && status="on disk" || status="migrated"
    fi

    #${MMLSATTR} -L "${file}" | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 && status="migrated" || status="on disk"

    return 0

}



#----------------------------------------------------------------------------
# glade_hsm migrate <filename(s)> subcommand
#----------------------------------------------------------------------------
migrate_files ()
{
    # quick return for no files
    [[ ${#FILELIST[@]} -eq 0 ]] && return

    while read -r file; do

        if [[ -e ${file} ]]; then
            if [[ ${file} = */COLD_STORAGE* ]]; then
                echo "--> Skpping ${file} (path already contains \"*/COLD_STORAGE*\"...)"
                continue
            else
                echo "Migrating ${file}"
            fi
        else
            echo "--> No such file: ${file}"
            continue
        fi

        local origfile=${file}
        local basefile=$(basename ${file})
        local oldtopdir=$(dirname ${file})
        local newtopdir=${oldtopdir}/${cold_storage_pathname}
        local newfile=${newtopdir}/${basefile}

        echo "  origfile = ${origfile}"
        echo "  newfile  = ${newfile}"
        echo

        if [[ -e ${newfile} ]]; then
            echo "  *** WARNING: newfile collision!! ***"
            echo "    --> skipping ${origfile}"
            echo "    --> since ${newfile} exists"
            continue
        fi

        get_confirmation "Are you sure you want to continue (y/n)?" \
            || { echo -e "not confirmed, continuing...\n"; continue; }

        #set -x
        mkdir -p ${newtopdir}
        mv ${origfile} ${newfile}
        #set +x

        migrate_request_stub="${log_dir}/migrate-${USER}-$(pathname_to_label ${file})-$(timestamp)"
        logfile="${migrate_request_stub}.log"

        cat <<EOF >${logfile}
$(timestamp): User: ${USER}
$(timestamp): Original File: ${origfile}
$(timestamp): New File:      ${newfile}
EOF

    done < <(echo "${FILELIST[@]}" | tr " " "\n" | sort -r | uniq)
}



#----------------------------------------------------------------------------
# glade_hsm migrate <dirname(s)> subcommand
#----------------------------------------------------------------------------
migrate_dirs ()
{
    # quick return for no directories
    [[ ${#DIRLIST[@]} -eq 0 ]] && return

    while read -r dir; do
        if [[ -s ${dir} ]]; then
            if [[ ${dir} = */COLD_STORAGE* ]]; then
                echo "--> Skpping ${dir} (path already contains \"*/COLD_STORAGE*\"...)"
                continue
            else
                echo "Migrating ${dir}"
            fi
        else
            echo "--> No such directory: ${dir}"
            continue
        fi

        local origdir=${dir}
        local basedir=$(basename ${dir})
        local oldtopdir=$(dirname ${dir})
        local newtopdir=${oldtopdir}/${cold_storage_pathname}
        local newdir=${newtopdir}/${basedir}

        echo "  origdir = ${origdir}"
        echo "  newdir  = ${newdir}"
        echo

        if [[ -d ${newdir} ]]; then
            echo "  *** WARNING: name collision!! ***"
            echo "    --> skipping ${origdir}"
            echo "    --> since ${newdir} exists"
            continue
        fi

        get_confirmation "Are you sure you want to continue (y/n)?" \
            || { echo -e "not confirmed, continuing...\n"; continue; }

        #set -x
        mkdir -p ${newtopdir}
        mv ${origdir} ${newdir}
        #set +x

        migrate_request_stub="${log_dir}/migrate-${USER}-$(pathname_to_label ${dir})-$(timestamp)"
        logfile="${migrate_request_stub}.log"

        cat <<EOF >${logfile}
$(timestamp): User: ${USER}
$(timestamp): Original Directory: ${origdir}
$(timestamp): New Directory:      ${newdir}
EOF
    done < <(echo "${DIRLIST[@]}" | tr " " "\n" | sort -r | uniq)
}



#----------------------------------------------------------------------------
# glade_hsm migrate subcommand
#----------------------------------------------------------------------------
do_migrate ()
{
    migrate_files
    migrate_dirs
}



#----------------------------------------------------------------------------
# glade_hsm recall <filename(s)> subcommand
#----------------------------------------------------------------------------
recall_files ()
{
    # quick return for no files
    [[ ${#FILELIST[@]} -eq 0 ]] && return

    # create a single filelist from all offline files in ${FILELIST[@]}
    local offline_file_list="$(mktemp)"

    # print the requested files NULL separated allows us to use the Python process scanner.
    filtered=()
    for f in "${FILELIST[@]}"; do
        [[ ${f} == */COLD_STORAGE* ]] && filtered+=("${f}")
    done
    export GLADE_HSM_RECALL_FILE_LIST=${offline_file_list}
    printf '%s\0' "${filtered[@]}" | ${SCRIPTDIR}/libexec/glade_hsm_scan_filelist.py

    # pure bash version follows - ~5X slower.
    # n_offline=0
    # bytes_offline=0

    # while read -r file; do

    #     check_file_status ${file}

    #     size_label=$(numfmt --to=iec-i --suffix=B --format="%.2f" "${true_size}")
    #     echo "${file}: [${size_label}, ${status}]"

    #     if [[ "migrated" = "${status}" ]]; then
    #         #echo "Requesting recall: '${file}'"
    #         echo "${file}" >> ${offline_file_list}
    #     else
    #         continue
    #     fi

    #     n_offline=$(( ${n_offline} + 1 ))
    #     bytes_offline=$(( ${bytes_offline} + ${true_size} ))

    # done < <(echo "${FILELIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE" | sort -r | uniq)


    # check for empty list
    if [[ ! -s ${offline_file_list} ]]; then
        echo "No offline files found in input file list."
        return
    else
        # sort the list, ensure unique, and overwrite
        # (This is safe because sort handles the temporary file internally to avoid clobbering the original content during sorting.)
        # This also will give us a consistent file ordering --> unique SHA below, regardless of input order of the files.
        sort -ru ${offline_file_list} -o ${offline_file_list}
        n_offline=$(wc -l ${offline_file_list} | awk '{print $1}')
    fi

    #size_offline=$(numfmt --to=iec-i --suffix=B --format="%.2f" "${bytes_offline}")
    #local msg="Requesting recall of ${n_offline} files / ${size_offline}\nAre you sure you want to continue (y/n)?"
    local msg="Are you sure you want to continue (y/n)?"

    get_confirmation ${msg} \
        || { echo -e "not confirmed, continuing...\n"; continue; }

    #echo ${offline_file_list}
    local sha_label=$(sha256sum ${offline_file_list} | awk '{print $1}')
    local recall_request_stub="${log_dir}/recall-${USER}-${sha_label}"
    local recall_request_file="${recall_request_stub}-$(timestamp)"
    local recall_request_log="${recall_request_file}.log"
    local recall_request_flist="${recall_request_file}.filelist"
    cat <<EOF > ${recall_request_log}
$(timestamp): ${USER} initiated recall request of ${n_offline} files
$(timestamp): requested file list: '${recall_request_flist}'
EOF
    cat ${recall_request_log}
    mv -f ${offline_file_list} ${recall_request_flist}
}



#----------------------------------------------------------------------------
# glade_hsm recall <dirname(s)> subcommand
#----------------------------------------------------------------------------
recall_dirs ()
{
    # quick return for no directories
    [[ ${#DIRLIST[@]} -eq 0 ]] && return

    while read -r dir; do
        cd ${dir} || continue

        curdir=$(pwd) # full path to recall directory

        recall_request_stub="${log_dir}/recall-${USER}-$(pathname_to_label ${curdir})"
        recall_request_file="${recall_request_stub}-$(timestamp)"
        recall_request_log="${recall_request_file}.log"
        recall_request_flist="${recall_request_file}.filelist"
        # we will create a temporary list and then move the final result to avoid a race condition
        # with the system process that is triggered by the existence of a "*.filelist" file
        recall_request_tmplist="$(mktemp)"

        export GLADE_HSM_RECALL_FILE_LIST=${recall_request_tmplist}
        find ${curdir} -type f -print0 | ${SCRIPTDIR}/libexec/glade_hsm_scan_filelist.py
        unset GLADE_HSM_RECALL_FILE_LIST

        # it is possible we found no files, in which case there is no temporary  list.
        if [[ -s ${recall_request_tmplist} ]]; then

            get_confirmation "Are you sure you want to continue (y/n)?" \
                || { echo -e "not confirmed, continuing...\n"; continue; }

            cat <<EOF > ${recall_request_log}
$(timestamp): ${USER} initiated '${curdir}' recall request
$(timestamp): requested file list: '${recall_request_flist}'
EOF
	    cat ${recall_request_log}
            mv -f ${recall_request_tmplist} ${recall_request_flist}
        else
            echo "no offline files found in ${curdir}"
        fi


    done < <(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE" | sort -r | uniq)
}



#----------------------------------------------------------------------------
# glade_hsm recall subcommand
#----------------------------------------------------------------------------
do_recall ()
{
    recall_files
    recall_dirs
}



#----------------------------------------------------------------------------
# glade_hsm status <filename(s)> subcommand
#----------------------------------------------------------------------------
status_files ()
{
    # quick return for no files
    [[ ${#FILELIST[@]} -eq 0 ]] && return

    while read -r file; do
        check_file_status ${file}

        size_label=$(numfmt --to=iec-i --suffix=B --format="%.2f" "${true_size}")
        echo "${file}: [${size_label}, ${status}]"

    done < <(echo "${FILELIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE")
}



#----------------------------------------------------------------------------
# glade_hsm status <dirname(s)> subcommand
#----------------------------------------------------------------------------
status_dirs ()
{
    # quick return for no directories
    [[ ${#DIRLIST[@]} -eq 0 ]] && return

    while read -r dir; do
        cd ${dir} || continue

        curdir=$(pwd)

        echo ${curdir}

	# echo "python version:"
        unset GLADE_HSM_RECALL_FILE_LIST
        find ${curdir} -readable -type f -print0 | ${SCRIPTDIR}/libexec/glade_hsm_scan_filelist.py

	# status any relevant log files from the past month
        local recall_logfile_search_pattern="recall-*$(pathname_to_label ${curdir})*.log"

        while read -r -d '' logfile; do
            #echo ${logfile}
            grep "${curdir}" ${logfile} -c >/dev/null 2>&1 || continue
            echo "Recall status:"
            cat ${logfile}
        done < <(find ${log_dir} -mtime -31 -type f -name "${recall_logfile_search_pattern}" -print0)
        echo
     done < <(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE") # | sort -r | uniq)"
}



#----------------------------------------------------------------------------
# glade_hsm status subcommand
#----------------------------------------------------------------------------
do_status ()
{
    status_files
    status_dirs
}



#----------------------------------------------------------------------------
# main program follows
#----------------------------------------------------------------------------
parse_args $@

case ${mode} in
    "migrate"|"recall"|"status")
        do_${mode}
        ;;

    *)
        echo "unknown mode ${mode} / not implemented!!"
        exit 1
        ;;
esac
