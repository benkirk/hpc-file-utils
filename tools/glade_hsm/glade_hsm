#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
recall_files ()
{
    sortedlist="$(echo "${FILELIST[@]}" | tr " " "\n" |  grep "COLD_STORAGE/" | sort -r | uniq)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo

    for file in ${sortedlist}; do

        mmlsattr -L ${file} | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 || continue

        echo ${file}

        recall_request_stub="${log_dir}/$(pathname_to_label ${file})"
        recall_request_file="${recall_request_stub}::${timestamp}"
        recall_request_log="${recall_request_file}.log"
        recall_request_flist="${recall_request_file}.filelist"
        echo ${recall_request_file}


        echo "# ${file} : recall requested on ${timestamp} by ${USER}" > "${recall_request_log}"
        echo "# (see ${recall_request_flist} for listing of recalled files)" >> "${recall_request_log}"
        echo "${file}" >> "${recall_request_flist}"
    done
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
recall_dirs ()
{
    sortedlist="$(echo "${DIRLIST[@]}" | tr " " "\n" |  grep "/COLD_STORAGE" | sort -r | uniq)"

    echo "sortedlist = "
    echo "${sortedlist}" && echo

    for dir in ${sortedlist}; do
        cd ${dir} || continue

        curdir=$(pwd)                  # full path to recall directory

        recall_request_stub="${log_dir}/$(pathname_to_label ${curdir})"
        recall_request_file="${recall_request_stub}::${timestamp}"
        recall_request_log="${recall_request_file}.log"
        recall_request_flist="${recall_request_file}.filelist"
        echo ${recall_request_file}

        echo "# ${curdir} : recall requested on ${timestamp} by ${USER}" > "${recall_request_log}"
        echo "# (see ${recall_request_flist} for listing of recalled files)" >> "${recall_request_log}"

        find ${curdir} ! -type d -print0 | \
            while read -r -d '' file; do

                mmlsattr -L ${file} | grep -c -e OFFLINE -e IBMTPS >/dev/null 2>&1 || continue
                echo "${file}" >> "${recall_request_flist}"
            done
    done
}



#----------------------------------------------------------------------------
#
#----------------------------------------------------------------------------
do_recall ()
{
    recall_files
    recall_dirs
}



