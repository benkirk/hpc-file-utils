#!/usr/bin/env bash

# -e: exit on error
# -u: treat unset variables as errors
# -o pipefail: fail if any command in a pipeline fails
set -euo pipefail

#----------------------------------------------------------------------------
# environment
SCRIPTDIR="$( cd "$( dirname $(realpath "${BASH_SOURCE[0]}") )" >/dev/null 2>&1 && pwd )"
source ${SCRIPTDIR}/common.sh
MMLSATTR="${MMLSATTR:-/usr/lpp/mmfs/bin/mmlsattr}"
#----------------------------------------------------------------------------


[[ -z ${USER} ]] && { echo "\$USER not defined!"; exit 1; }

[[ -z ${HOME} ]] && { echo "no \$HOME directory defined."; exit 1; }
[[ -w ${HOME} ]] || { echo "no writable \$HOME directory: ${HOME}"; exit 1; }

purgedir="INVALID"

find_cmd="lfs find"
PURGELIST_DIRS=()
PURGELIST_FILES=()

# state information & logging support
CONFDIR="${HOME}/.glade_purge"
LOGDIR="${CONFDIR}"
LOGFILE="${LOGDIR}/log"
KNOWN_PURGEDIRS="${CONFDIR}/purgedirs.list"
mkdir -p ${CONFDIR} ${LOGDIR}



#----------------------------------------------------------------------------
# simple help message
#----------------------------------------------------------------------------
usage()
{
    local prog=${0##*/}
    cat <<-EOF
usage: $prog [-h -p -f -v -q] dir0 ... dirN

Purge files & directories from a filesystem. Files are removed immediately,
directories are relocated for later batch removal.

examples
    \$ $prog ./mydir/*
    remove all subdirs from ./mydir; leaves ./mydir empty.

    \$ $prog -f *
    removes everything from the current directory, without prompting
    (replacement for rm -rf *)

options
    -h|--help      print this message and exit
    -p|--prompt    prompt for confirmation
    -f|--force     force, e.g. do not prompt for confirmation
    -v|--verbose   verbose
    -q|--quiet     quiet
    --clean        removes stashed items
EOF
}



#----------------------------------------------------------------------------
# process command line args
#----------------------------------------------------------------------------
process_command_line()
{
    # default VALUES
    CONFIRM=YES
    VERBOSE=YES
    SPAWN_PURGE=NO
    unset PURGELIST_DIRS
    unset PURGELIST_FILES

    # no args --> help
    [[ 0 -ne ${#} ]] || { usage; exit 0; }

    while [[ ${#} -gt 0 ]] ; do
        key="${1}"

        case ${key} in
            -h|--help)
                usage
                exit 0
                ;;
            -f|--force)
                CONFIRM=NO
                shift # past argument
                ;;
            -p|--propmt)
                CONFIRM=YES
                shift # past argument
                ;;
            -q|--quiet)
                VERBOSE=NO
                shift # past argument
                ;;
            -v|--verbose)
                VERBOSE=YES
                shift # past argument
                ;;
            --clean)
                SPAWN_PURGE=YES
                shift # past argument
                ;;
            "-"*)
                # unknown option (unmatched -<foo>)
                echo "unrecognized argument: ${1}" && echo
                usage
                exit 1
                ;;

            *)
                if [[ -d ${1} ]]; then
                    PURGELIST_DIRS+=($(realpath "${1}")) # save directory in an array for later
                elif [[ -f ${1} || -L ${1} ]]; then
                    PURGELIST_FILES+=("${1}") # save file,symlink in an array for later
                else
                    # unknown option
                    echo "unrecognized argument - no such file or directory?: ${1}" && echo
                    usage
                    exit 1
                fi
                shift # past argument
                ;;
        esac
    done
}



#----------------------------------------------------------------------------
# promt for confirmation, storing confirmed=0/1.
#  - force reading interactive from /dev/tty
#----------------------------------------------------------------------------
get_confirmation()
{
    local msg="$@"
    confirmed=0
    if [[ "NO" == "${CONFIRM}" ]]; then
        confirmed=1
    else
        printf "%b" "${msg} " # <-- interprets any \n in ${msg}
        read -n 1 -r reply </dev/tty
        echo
        if [[ ${reply} =~ ^[Yy]$ ]]; then
            confirmed=1
        fi
    fi

    [[ 1 -eq ${confirmed} ]] || { echo "not confirmed, exiting"; exit 1; }
}



#----------------------------------------------------------------------------
# echo; unless not VERBOSE
#----------------------------------------------------------------------------
verbose_echo()
{
    [[ "NO" == "${VERBOSE}" ]] && return
    echo "${@}"
}



#----------------------------------------------------------------------------
# print a message to the logfile
#----------------------------------------------------------------------------
log_msg()
{
    local timestamp="$(date +%F@%H:%M:%S)"
    mkdir -p ${LOGDIR} || exit 1
    echo -e "[${timestamp}]: ${@}" >> ${LOGFILE}
}



#----------------------------------------------------------------------------
# determine GPFS fileset an item belongs to (if any)
#----------------------------------------------------------------------------
get_fileset()
{
    fileset="INVALID"

    [[ 1 -eq ${#} ]] || { echo "get_fileset() expecting only 1 argument!"; exit 1; }

    fileset=$(${MMLSATTR} -L ${1} 2>/dev/null | grep -i "fileset" || echo "not_GPFS")
    echo "${fileset}"
}



#----------------------------------------------------------------------------
# determine appropriate purge directory for a given item:
#  walk up a directory tree to find topmost writable path on the same fileset
#  set result as 'purgedir'
#----------------------------------------------------------------------------
get_purgedir()
{
    [[ 1 -eq ${#} ]] || { echo "get_topmost_writable_directory() expecting only 1 argument!"; exit 1; }

    purgedir="INVALID"

    local topdir="${1}"
    local topdir_fileset="$(get_fileset ${topdir})"

    #echo ${topdir}
    #echo ${topdir_fileset}

    local top_writable="INVALID"
    local dir=$(realpath "${topdir}")

    # walk up the directory tree; saving the topmost
    # writable directory on the same fileset - so that mv's remain fast.
    while [[ "${dir}" != "/" ]]; do
        if [[ -w "${dir}" ]]; then
            if [[ "$(get_fileset ${dir})" == "${topdir_fileset}" ]]; then
                top_writable="${dir}"
            fi
        fi
        dir=$(dirname "${dir}")
    done

    # no suitable path found - error
    if [[ "INVALID" == "${top_writable}" ]]; then
        echo "Cannot purge ${topdir}"
        echo "no writable directories in hierarchy found!"
        exit 1

    # otherwise;
    else
        purgedir=$(realpath "${top_writable}/.PURGE")
        #echo "${top_writable}"
        #echo "${purgedir}"

        # create purgedir if needed
        if [[ ! -d ${purgedir} ]]; then

            # defult permissions for new .PURGE/ directories -
            # (make group writable on campaign, but don't be tricked by
            # '/glade/campaign/work/'  - same as /glade/work)
            local newdir_mode="u=rwx,g=rx,o=rx"
            local set_sticky_bit=0
            local set_setgid=0

            case "${topdir}" in
                "/glade/campaign/work/"*) ;;
                "/gpfs/csfs1/work/"*) ;;
                "/glade/campaign/"*) ;& # <-- Fallthrough
                "/gpfs/csfs1/"*)
                    newdir_mode="u=rwx,g=rwx,o=rx"
                    set_sticky_bit=1
                    set_setgid=1
                    ;;
            esac

            message="Creating new purge directory: ${purgedir}"
            verbose_echo "${message}"
            mkdir -p --mode=${newdir_mode} ${purgedir}
            if [[ 1 -eq ${set_sticky_bit} ]]; then
                chmod +t ${purgedir}
            fi
            if [[ 1 -eq ${set_setgid} ]]; then
                chmod g+s ${purgedir}
            fi

            # only log now - if successful
            log_msg "Creating new purge directory: '$(ls -ld ${purgedir})'"

        # exists but not writable - error
        elif [[ ! -w ${purgedir} ]]; then
            echo "ERROR: cannot write to existing purge directory - check ownership and permissions::"
            ls -ld ${purgedir}
            exit 1
        fi

        # we have a usable purgedir - save its existence for future cleanup
        # append if not in list
        # grep:
        #     -F: fixed string match (not regex),
        #     -x: match the whole line,
        #     -q: quiet, no output — just returns 0 or 1.
        grep -Fxq "${purgedir}" "${KNOWN_PURGEDIRS}" 2>/dev/null || echo "${purgedir}" >> "${KNOWN_PURGEDIRS}"
    fi
}



#----------------------------------------------------------------------------
# place items into appropriate purge directory for later removal
#----------------------------------------------------------------------------
stash_items()
{
    local lockfile=${CONFDIR}/stash.lock
    (
        flock -w 1 9 || { echo "cannot obtain lock on ${lockfile}"; exit 1; }

        if [[ ${#} -eq 0 ]]; then
            return 0
        fi

        get_confirmation "\nAre you sure you want to purge\n${@}\nFrom the filesystem (y/n)?"

        local timestamp=$(date +%F)

        for item in ${@}; do

            # remove files/symlinks
            if [[ -f ${item} || -L ${item} ]]; then
                verbose_echo "  --> Removing ${item}"
                /bin/rm -f ${item}
                continue
            fi

            # directories
            get_purgedir ${item}
            [[ -w "${purgedir}" ]] || { echo "ERROR: no writable purge directory found: purgedir=${purgedir}"; exit 1; }

            item_tmpdir=$(mktemp -d --tmpdir=${purgedir} ${USER}-purge-${timestamp}.XXXXXXXXXX)
            # attempt to give 'csgteam' read permissions to the tmpdir via ACL - ignoring errors
            # (will not change permissions of contents)
            setfacl -m u:csgteam:rX ${item_tmpdir} 2>/dev/null || true

            # move the requested directory into a new directory under purgedir, with logging
            if [[ -w ${item_tmpdir} ]] ; then
                message="Moving '${item}' into '${item_tmpdir}' for deferred removal"
                verbose_echo "  --> ${message}"
                mv ${item} ${item_tmpdir}
                log_msg "${message}"
                echo "${message}" > ${item_tmpdir}/stash.log

                # error handling
            else
                echo "ERROR: \"mktemp -d --${purgedir}\" failed!"
                exit 1
            fi
        done

    ) 9>${lockfile}
}



#----------------------------------------------------------------------------
# Update the list of known .PURGE/ directories
#----------------------------------------------------------------------------
update_known_purgedirs()
{
    # quick return if KNOWN_PURGEDIRS is empty
    [[ -f "${KNOWN_PURGEDIRS}" ]] || return 0

    # Create a temporary file
    tmp=$(mktemp)

    while IFS= read -r dir; do

        # Keep only existing directories
        if [[ -d "${dir}" ]]; then
            if [[ -n "$(ls -A ${dir})" ]]; then
                echo "${dir}" >> "$tmp"
            else
                verbose_echo "cleanup: ${dir} exists but is empty, removing..."
                /bin/rmdir ${dir} 2>/dev/null \
                    && log_msg "Removing empty purge directory: ${dir}" \
                        || echo "${dir}" >> "$tmp"
            fi
        else
            verbose_echo "cleanup: ${dir} no longer exists - removing from ${KNOWN_PURGEDIRS}"
        fi

    done < "${KNOWN_PURGEDIRS}"

    # Replace original file

    mv -f "${tmp}" "${KNOWN_PURGEDIRS}"
}



#----------------------------------------------------------------------------
# remove an individual directory
#----------------------------------------------------------------------------
purge_subdir()
{
    [[ 1 -eq ${#} ]] || { echo "ERROR: expecting 1 argument, \$@="$@; exit 1; }

    local my_subdir=$(realpath "${1}")
    local maxargs=10000
    local n_concurrent=6

    # does my_subdir still exist? could have been cleaned up by a different process
    [[ -d ${my_subdir} ]] || return

    # pedantic error checking; make sure we're removing something under a ".PURGE" directory
    [[ "${my_subdir}" == *"/.PURGE/"* ]] || { echo "Refusing to process ${my_subdir} - path does not contain \"/.PURGE/\"!"; exit 1; }

    (cd "${my_subdir}" && pwd >/dev/null 2>&1) || { echo "cannot cd into ${my_subdir}!" ; exit 1; }

    verbose_echo "    --> ${my_subdir}"

    log_msg "Purging '${my_subdir}'"

    # ${find_cmd} any regular files, symlinks, etc...
    ${find_cmd} ${my_subdir} ! -type d -print0 2>/dev/null | xargs --max-args=${maxargs} -r -0 -P ${n_concurrent} /bin/rm -f

    # remove empty directories
    find ${my_subdir} -depth -type d -print0 2>/dev/null | xargs 2>/dev/null --max-args=${maxargs} -r -0 -P ${n_concurrent} /bin/rmdir
    #find ${my_subdir} -type d -empty -print0 | xargs --max-args=${maxargs} -r -0 -P ${n_concurrent} /bin/rmdir

    # rm -rf last resort, if it still exists
    if [[ -d ${my_subdir} ]]; then
        verbose_echo "falling back to rm -rf ${my_subdir}"
        /bin/rm -vrf ${my_subdir}
    fi
}



#----------------------------------------------------------------------------
# remove items from known purge directories
#----------------------------------------------------------------------------
purge_directories()
{
    local lockfile=${CONFDIR}/purge.lock
    (
        flock -w 1 9 || { echo "cannot obtain lock on ${lockfile}"; exit 1; }

        # quick return if KNOWN_PURGEDIRS is empty
        [[ -s "${KNOWN_PURGEDIRS}" ]] || return 0

        # ... commands executed under lock ...
        get_confirmation  "\nAre you sure you want to purge items in\n$(cat ${KNOWN_PURGEDIRS} | tr '\n' ' ')\nFrom the filesystem (y/n)?"

        while IFS= read -r purgedir; do

            echo "  --> Purging ${purgedir}"

            # be sure purgedir is available, and usable, so
            # we don't remove stuff in the wrong place!!
            [[ -d ${purgedir} ]] || continue
            (cd ${purgedir} && pwd >/dev/null 2>&1) || { echo "cannot cd into ${purgedir}!" ; exit 1; }

            # loop over top-level subdirectories from purgedir
            while read -r -d '' subdir; do

                purge_subdir ${subdir}

            done < <(find ${purgedir} -maxdepth 1 -mindepth 1 -type d -name "${USER}-purge-*"  -print0)
            # end loop on subdirectories

        done < "${KNOWN_PURGEDIRS}"
        # end loop on purgedirs

        update_known_purgedirs

        verbose_echo "Done."

    ) 9>${lockfile}
}



#----------------------------------------------------------------------------
# Main program follows
#----------------------------------------------------------------------------
process_command_line ${@}

stash_items "${PURGELIST_FILES[@]}" "${PURGELIST_DIRS[@]}"
[[ "YES" == "${SPAWN_PURGE}" ]] && purge_directories

exit 0
